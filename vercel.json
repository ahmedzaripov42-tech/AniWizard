{
  "version": 2,
  "builds": [
    {
      "src": "bot.php",
      "use": "vercel-php@0.7.2"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/bot.php"
    }
  ],
  "env": {
    "BOT_TOKEN": "@bot_token",
    "DB_HOST": "@db_host",
    "DB_USER": "@db_user",
    "DB_PASS": "@db_pass",
    "DB_NAME": "@db_name"
  }
}
